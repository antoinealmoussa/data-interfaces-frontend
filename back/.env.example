# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=localdb

# JWT
SECRET_KEY=change_me_to_a_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cookie
ACCESS_TOKEN_COOKIE_SECURE=False

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_MODEL=mistral-small

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Strava OAuth — créer une app sur https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/v1/bike-exploration/strava/callback
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=DEBUG
